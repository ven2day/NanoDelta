# NSE — Dhan historical primary/realtime fallback
DHAN_CLIENT_ID=

# Option A — manually generated 24-hour token
DHAN_ACCESS_TOKEN=

# Option B — automatic token generation. Store values in protected files, not this env file.
DHAN_PIN_PATH=
DHAN_TOTP_SECRET_PATH=

# User-supplied NSE universe. Blank security_id values resolve from Dhan's official master.
NSE_SYMBOLS_CSV=config/nse/symbols.csv

# NSE — TrueData realtime primary/historical fallback
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
