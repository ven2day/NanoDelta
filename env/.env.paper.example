# Paper trading allocation and risk policy — one independent equity pool per
# market (NSE, Forex, and Crypto each get their own account of this size, not
# a shared pool). Order sizing is governed primarily by the risk-per-trade
# figure against each trade's stop distance; the notional/exposure caps below
# are a paper-only backstop and default to full equity (effectively
# unconstrained) unless overridden.

# Required — no defaults.
NANODELTA_PAPER_EQUITY_INR=3000000
NANODELTA_PAPER_RISK_PER_TRADE_INR=2000
NANODELTA_PAPER_MAX_POSITIONS=300
NANODELTA_PAPER_MAX_SECTOR_POSITIONS=30

# Optional — default to full equity (no additional constraint beyond capital).
NANODELTA_PAPER_MAX_ORDER_NOTIONAL_INR=
NANODELTA_PAPER_MAX_TOTAL_NEW_NOTIONAL_INR=
NANODELTA_PAPER_MAX_POSITION_NOTIONAL_INR=
NANODELTA_PAPER_MAX_MARKET_GROSS_EXPOSURE_INR=
NANODELTA_PAPER_MAX_TOTAL_GROSS_EXPOSURE_INR=

# Optional — defaults to 300 (same as NANODELTA_PAPER_MAX_POSITIONS).
NANODELTA_PAPER_MAX_OPEN_POSITIONS=

# Optional — defaults to 5% of equity. This is a real circuit breaker: once
# today's realized loss reaches this figure, CyclePreconditions.daily_loss_capacity
# goes false and no new entries are taken for the rest of the day. Review before
# relying on the default.
NANODELTA_PAPER_MAX_DAILY_LOSS_INR=

# Optional — defaults to 30 seconds (RiskEngine's own default).
NANODELTA_PAPER_MAX_SNAPSHOT_AGE_SECONDS=
