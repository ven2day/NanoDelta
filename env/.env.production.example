POSTGRES_DB=nanodelta
POSTGRES_USER=nanodelta
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
# Absolute host-managed config in production; the default receiver intentionally sends nothing.
ALERTMANAGER_CONFIG_PATH=./deploy/observability/alertmanager/alertmanager.yml
GRAFANA_PORT=3001

# Explicit paper-only market runtime (enabled with --profile market-runtime).
NANODELTA_INSTANCE_ID=nanodelta-runtime-1
NANODELTA_HEARTBEAT_SECONDS=10
NANODELTA_DRAIN_TIMEOUT_SECONDS=30
NANODELTA_RUNTIME_METRICS_PORT=9101
NSE_DHAN_SECURITY_IDS_JSON={"RELIANCE":"1333"}
TRUEDATA_USERNAME=replace-me
DHAN_CLIENT_ID=replace-me
FOREX_SYMBOLS=EUR_USD,GBP_USD
OANDA_ACCOUNT_ID=replace-me
OANDA_ENVIRONMENT=practice
CRYPTO_SYMBOLS=BTC_USDT,ETH_USDT
NANODELTA_PAPER_ACCOUNT_ID=paper-default
NANODELTA_PAPER_EQUITY_INR=3000000
NANODELTA_PAPER_RISK_PER_TRADE_INR=2000
NANODELTA_PAPER_MAX_POSITIONS=300
NANODELTA_PAPER_MAX_SECTOR_POSITIONS=30
NANODELTA_PAPER_SLIPPAGE_BPS=2
NANODELTA_PAPER_FEE_BPS=1
