[Unit]
Description=NanoDelta TimescaleDB backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=nanodelta
Group=nanodelta
WorkingDirectory=/opt/nanodelta
EnvironmentFile=/opt/nanodelta/.env.production
ExecStart=/usr/bin/flock --nonblock /run/lock/nanodelta-backup.lock /opt/nanodelta/scripts/backup.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nanodelta/backups /run/lock

