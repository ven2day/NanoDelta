  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (market) (rate(nanodelta_http_requests_total[5m]))", "legendFormat": "{{market}}", "refId": "A"}],
      "title": "Request rate by market",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(nanodelta_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(nanodelta_http_requests_total[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "Server error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, market) (rate(nanodelta_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{market}}", "refId": "A"}],
      "title": "p95 API latency by market",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (method, route, status) (rate(nanodelta_http_requests_total[5m]))", "format": "table", "instant": true, "refId": "A"}],
      "title": "Request outcomes by bounded route",
      "type": "table"
    }
  ],
  "refresh": "30s",
